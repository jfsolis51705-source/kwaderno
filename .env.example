# ---- Core (required)
DATABASE_URL=postgres://kwaderno:kwaderno@localhost:5432/kwaderno
# Separate database used by `npm test` (it is wiped between test files)
TEST_DATABASE_URL=postgres://kwaderno:kwaderno@localhost:5432/kwaderno_test
# Public origin of the app, used for CSRF origin checks
APP_URL=http://localhost:3000
# Session lifetime in days
SESSION_TTL_DAYS=30

# ---- File storage (receipts, product images). Never served publicly; read through authorized routes.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=10

# ---- AI receipt service (optional; manual inventory works without it)
AI_SERVICE_URL=http://localhost:8001
# Shared secret between the app and the AI worker (server-side only)
AI_SERVICE_TOKEN=change-me
# Max time to wait for one receipt extraction
AI_TIMEOUT_MS=120000
# Set to 0 to disable automatic processing after upload (tests do this)
RECEIPT_AUTO_PROCESS=1

# ---- AI service (ai-service/, separate process; these are read THERE, never by the browser)
# RECEIPT_PROVIDER=gemini | paddle_qwen | mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# QWEN_VL_BASE_URL=http://gpu-host:8000/v1
# QWEN_VL_MODEL=Qwen/Qwen3-VL-8B-Instruct
