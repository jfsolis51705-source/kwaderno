# ---- backend (backend/) ----
# SQLite by default; for PostgreSQL install psycopg (see requirements.txt) and use e.g.
# DATABASE_URL=postgresql+psycopg://kwaderno:kwaderno@localhost:5432/retail_intel
DATABASE_URL=
# Where photos, receipts and product thumbnails are stored (served at /media)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Load demo stores/products/captures/orders on an empty database (1 = yes)
SEED_DEMO=1
# Browser origins allowed to call the API directly (the Vite dev/preview proxies don't need this)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vision provider: mock (default, no key, deterministic) | openai_compatible | anthropic
VISION_PROVIDER=mock
# For openai_compatible: OpenAI, Gemini's OpenAI-compatible endpoint, or a self-hosted Qwen-VL/InternVL served by vLLM
# VISION_API_BASE=https://api.openai.com/v1
# VISION_MODEL=gpt-4o-mini
# For anthropic:
# VISION_API_BASE=https://api.anthropic.com
# VISION_MODEL=claude-sonnet-5-5
# Server-side only. Never put this in the frontend.
VISION_API_KEY=

# ---- frontend (frontend/) ----
# API the Vite dev/preview server proxies /api and /media to
API_URL=http://127.0.0.1:8100
# Only if the web app is hosted separately from the API (otherwise leave empty and use the proxy)
VITE_API_BASE=
